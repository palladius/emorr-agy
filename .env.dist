
# Telegram config
TELEGRAM_BOT_TOKEN="your token here"
TELEGRAM_CHAT_ID="1234567890"

# Server PIN for Telegram authentication.
# Server refuses to start if this is not set.
# 3 wrong attempts = server shuts down (security kill switch).
EMORR_AGY_PIN="4242"

# Path to the YAML config for remote agy folder whitelist.
# Default: ~/.emorr-agy-folders.yaml
# EMORR_AGY_FOLDERS_YAML="/path/to/your/emorr-agy-folders.yaml"

# Check deterministicallty end of message. this is to save time on LLM classification.
EXCLUDE_RESUSCITATE="chumbawamba,HO_FINITO"
